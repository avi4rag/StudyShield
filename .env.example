# PostgreSQL connection string
# Copy this file to .env and fill in your actual values

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/studyshield"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/studyshield"

# Authentication secret for JWT token signing (minimum 32 characters)
JWT_SECRET="your_long_random_jwt_secret_key_at_least_32_chars_long"

# Auth.js and Google OAuth
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

